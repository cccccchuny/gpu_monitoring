# ════════════════════════════════════════════════════════════
#  GPU 서버 모니터링 스택 - 환경변수 설정
#  GPU 서버에 반입 후 이 파일만 수정하면 됩니다.
# ════════════════════════════════════════════════════════════

# ── 포트 설정 ─────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
CADVISOR_PORT=8080
NODE_EXPORTER_PORT=9100
DCGM_EXPORTER_PORT=9400

# ── Grafana 관리자 계정 ───────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin123

# ── Prometheus 데이터 보존 기간 ───────────────────────────
PROMETHEUS_RETENTION=15d

# ── 디스크 모니터링 대상 경로 ─────────────────────────────
# GPU 서버에서 df -h 결과를 보고 위협이 되는 파티션 경로로 수정
# 여러 경로는 | 로 구분 (정규식), 예: ^(/|/data|/mnt/storage)$
# 이 값은 Grafana 대시보드 변수의 기본값으로 사용됩니다.
DISK_MONITOR_PATHS=^(/|/data|/mnt)$

# ── DCGM Exporter 수집 간격 (밀리초) ─────────────────────
DCGM_INTERVAL=5000

# ── 타임존 설정 ───────────────────────────────────────────
TZ=Asia/Seoul
