{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "실행 중인 Docker 컨테이너 목록 및 리소스 사용량",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "서버 리소스", "url": "/d/host-resources", "type": "link", "icon": "external link" },
    { "title": "GPU 리소스",  "url": "/d/gpu-resources",  "type": "link", "icon": "external link" }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "실행 중인 컨테이너 수",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red",    "value": 20 }
            ]
          },
          "mappings": [],
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(container_last_seen{name=~\"$container_name\", name!=\"\", name!~\".*_exporter.*|prometheus|grafana|cadvisor\"})",
          "instant": true,
          "legendFormat": "컨테이너 수"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "총 컨테이너 CPU 사용률",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red",    "value": 80 }
            ]
          },
          "unit": "percent",
          "max": 100
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"$container_name\", name!=\"\", name!~\".*_exporter.*|prometheus|grafana|cadvisor\"}[2m])) * 100",
          "instant": true,
          "legendFormat": "CPU %"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "총 컨테이너 메모리 사용량",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 4000000000 },
              { "color": "red",    "value": 8000000000 }
            ]
          },
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(container_memory_working_set_bytes{name=~\"$container_name\", name!=\"\", name!~\".*_exporter.*|prometheus|grafana|cadvisor\"})",
          "instant": true,
          "legendFormat": "메모리"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "컨테이너 상태 목록",
      "description": "현재 실행 중인 컨테이너 — 컨테이너명 필터로 조회 범위를 조정하세요",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "컨테이너명", "desc": false }],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left", "displayMode": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "unit", "value": "percent" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 30 },
                { "color": "red", "value": 70 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "메모리" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          },
          {
            "matcher": { "id": "byName", "options": "마지막 확인" },
            "properties": [{ "id": "unit", "value": "dateTimeAsLocal" }]
          }
        ]
      },
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "name": "컨테이너명",
              "image": "이미지",
              "Value #A": "CPU %",
              "Value #B": "메모리",
              "Value #C": "마지막 확인"
            },
            "indexByName": { "컨테이너명": 0, "이미지": 1, "CPU %": 2, "메모리": 3, "마지막 확인": 4 },
            "excludeByName": { "Time": true, "job": true, "instance": true, "__name__": true }
          }
        }
      ],
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"$container_name\", name!=\"\"}[2m]) * 100",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "container_memory_working_set_bytes{name=~\"$container_name\", name!=\"\"}",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "container_last_seen{name=~\"$container_name\", name!=\"\"} * 1000",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "컨테이너별 CPU 사용률 (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "gradientMode": "none" },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"$container_name\", name!=\"\"}[2m]) * 100",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "컨테이너별 메모리 사용량",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "gradientMode": "none" },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "container_memory_working_set_bytes{name=~\"$container_name\", name!=\"\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "컨테이너별 네트워크 수신 (bytes/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(container_network_receive_bytes_total{name=~\"$container_name\", name!=\"\"}[2m])",
          "legendFormat": "{{name}} RX"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "컨테이너별 네트워크 송신 (bytes/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(container_network_transmit_bytes_total{name=~\"$container_name\", name!=\"\"}[2m])",
          "legendFormat": "{{name}} TX"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["container", "docker"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "pluginId": "prometheus",
        "hide": 2,
        "current": { "text": "Prometheus", "value": "Prometheus" }
      },
      {
        "name": "container_name",
        "label": "컨테이너명",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": {
          "query": "label_values(container_last_seen{name!=\"\"}, name)",
          "refId": "StandardVariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "① 컨테이너 목록",
  "uid": "container-list",
  "version": 1
}
