{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "NVIDIA GPU 리소스 — 온도 / VRAM / 사용률 / 전력 / 클럭 (DCGM Exporter)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "컨테이너 목록", "url": "/d/container-list", "type": "link", "icon": "external link" },
    { "title": "서버 리소스",   "url": "/d/host-resources",  "type": "link", "icon": "external link" }
  ],
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "GPU 요약",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "GPU 온도 (°C)",
      "description": "임계값: 80°C 주의, 90°C 위험",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "orange", "value": 80 },
              { "color": "red",    "value": 90 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "DCGM_FI_DEV_GPU_TEMP{gpu=~\"$gpu\"}",
          "instant": true,
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "GPU 사용률 (%)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",   "value": null },
              { "color": "green",  "value": 20 },
              { "color": "yellow", "value": 70 },
              { "color": "red",    "value": 95 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "DCGM_FI_DEV_GPU_UTIL{gpu=~\"$gpu\"}",
          "instant": true,
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "VRAM 사용률 (%)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "orange", "value": 85 },
              { "color": "red",    "value": 95 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"} / (DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"} + DCGM_FI_DEV_FB_FREE{gpu=~\"$gpu\"}) * 100",
          "instant": true,
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "전력 소비 (W)",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "orange", "value": 300 },
              { "color": "red",    "value": 400 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "DCGM_FI_DEV_POWER_USAGE{gpu=~\"$gpu\"}",
          "instant": true,
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },

    {
      "id": 10,
      "type": "row",
      "title": "VRAM 상세",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "VRAM 사용 / 여유 (MiB)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 16000 },
              { "color": "red",    "value": 22000 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"}",
          "instant": true,
          "legendFormat": "GPU {{gpu}} 사용"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "DCGM_FI_DEV_FB_FREE{gpu=~\"$gpu\"}",
          "instant": true,
          "legendFormat": "GPU {{gpu}} 여유"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "VRAM 사용량 추이 (MiB)",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 20, "gradientMode": "opacity" },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"}",
          "legendFormat": "GPU {{gpu}} VRAM 사용"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"} + DCGM_FI_DEV_FB_FREE{gpu=~\"$gpu\"}",
          "legendFormat": "GPU {{gpu}} VRAM 전체"
        }
      ]
    },

    {
      "id": 20,
      "type": "row",
      "title": "GPU 사용률 & 온도 추이",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "GPU 사용률 추이 (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "opacity" },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red",    "value": 95 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "DCGM_FI_DEV_GPU_UTIL{gpu=~\"$gpu\"}",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "GPU 온도 추이 (°C)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "opacity" },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "orange", "value": 80 },
              { "color": "red",    "value": 90 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "DCGM_FI_DEV_GPU_TEMP{gpu=~\"$gpu\"}",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },

    {
      "id": 30,
      "type": "row",
      "title": "전력 & 클럭",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "전력 소비 추이 (W)",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 24 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "watt", "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "opacity" },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "DCGM_FI_DEV_POWER_USAGE{gpu=~\"$gpu\"}",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "SM Clock 추이 (MHz)",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 24 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "DCGM_FI_DEV_SM_CLOCK{gpu=~\"$gpu\"} * 1e6",
          "legendFormat": "GPU {{gpu}} SM"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "DCGM_FI_DEV_MEM_CLOCK{gpu=~\"$gpu\"} * 1e6",
          "legendFormat": "GPU {{gpu}} Mem"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "PCIe 처리량 (MB/s)",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 24 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "DCGM_FI_DEV_PCIE_TX_THROUGHPUT{gpu=~\"$gpu\"} * 1024",
          "legendFormat": "GPU {{gpu}} TX"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "DCGM_FI_DEV_PCIE_RX_THROUGHPUT{gpu=~\"$gpu\"} * 1024",
          "legendFormat": "GPU {{gpu}} RX"
        }
      ]
    },

    {
      "id": 40,
      "type": "row",
      "title": "기타 GPU 정보",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }
    },
    {
      "id": 41,
      "type": "table",
      "title": "GPU 현재 상태 요약",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "GPU", "desc": false }] },
      "fieldConfig": {
        "defaults": { "custom": { "align": "center" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "온도(°C)" }, "properties": [
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "orange", "value": 80 },
              { "color": "red",    "value": 90 }
            ]}}
          ]},
          { "matcher": { "id": "byName", "options": "GPU 사용률(%)" }, "properties": [
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "unit", "value": "percent" },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red",    "value": 95 }
            ]}}
          ]},
          { "matcher": { "id": "byName", "options": "VRAM 사용률(%)" }, "properties": [
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "unit", "value": "percent" },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "orange", "value": 85 },
              { "color": "red",    "value": 95 }
            ]}}
          ]},
          { "matcher": { "id": "byName", "options": "전력(W)" }, "properties": [{ "id": "unit", "value": "watt" }] },
          { "matcher": { "id": "byName", "options": "VRAM 사용(MiB)" }, "properties": [{ "id": "unit", "value": "decmbytes" }] },
          { "matcher": { "id": "byName", "options": "VRAM 전체(MiB)" }, "properties": [{ "id": "unit", "value": "decmbytes" }] }
        ]
      },
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "gpu": "GPU",
              "Value #A": "온도(°C)",
              "Value #B": "GPU 사용률(%)",
              "Value #C": "VRAM 사용(MiB)",
              "Value #D": "VRAM 전체(MiB)",
              "Value #E": "VRAM 사용률(%)",
              "Value #F": "전력(W)"
            },
            "indexByName": { "GPU": 0, "온도(°C)": 1, "GPU 사용률(%)": 2, "VRAM 사용(MiB)": 3, "VRAM 전체(MiB)": 4, "VRAM 사용률(%)": 5, "전력(W)": 6 },
            "excludeByName": { "Time": true, "job": true, "instance": true, "__name__": true, "modelName": true, "Hostname": true, "UUID": true }
          }
        }
      ],
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "DCGM_FI_DEV_GPU_TEMP{gpu=~\"$gpu\"}",  "instant": true, "legendFormat": "{{gpu}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "DCGM_FI_DEV_GPU_UTIL{gpu=~\"$gpu\"}",  "instant": true, "legendFormat": "{{gpu}}", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"}",   "instant": true, "legendFormat": "{{gpu}}", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"} + DCGM_FI_DEV_FB_FREE{gpu=~\"$gpu\"}", "instant": true, "legendFormat": "{{gpu}}", "refId": "D" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"} / (DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"} + DCGM_FI_DEV_FB_FREE{gpu=~\"$gpu\"}) * 100", "instant": true, "legendFormat": "{{gpu}}", "refId": "E" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "DCGM_FI_DEV_POWER_USAGE{gpu=~\"$gpu\"}", "instant": true, "legendFormat": "{{gpu}}", "refId": "F" }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["gpu", "nvidia", "dcgm"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "pluginId": "prometheus",
        "hide": 2,
        "current": { "text": "Prometheus", "value": "Prometheus" }
      },
      {
        "name": "gpu",
        "label": "GPU",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": {
          "query": "label_values(DCGM_FI_DEV_GPU_TEMP, gpu)",
          "refId": "StandardVariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "description": "모니터링할 GPU를 선택하세요"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "③ GPU 리소스",
  "uid": "gpu-resources",
  "version": 1
}
